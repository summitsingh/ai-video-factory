# Copy to .env and fill in your own values. Never commit .env.
# Only the keys for sources you use are required; everything else has a fallback.

# --- Stock footage (free API keys; get them from pexels.com/api and pixabay.com/api) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Music bed ---
# Optional: path to your own royalty-free track used as the narration bed.
# If unset, the pipeline tries Internet Archive, Openverse, and Freesound
# (in that order), then falls back to a generated ambient drone.
MUSIC_BED_PATH=
# Optional: needed only if you want the Freesound provider in the fallback chain.
# FREESOUND_API_KEY=

# --- Captions ---
# Set to 0 to disable burned-in karaoke captions (SRT/VTT are still exported).
AVF_KARAOKE_CAPTIONS=1

# --- YouTube upload (optional; only for `ai-video-factory youtube upload`) ---
# AVF_YOUTUBE_DATA_DIR=~/.config/ai-video-factory/youtube
# AVF_YOUTUBE_QUOTA_BUDGET=10000
